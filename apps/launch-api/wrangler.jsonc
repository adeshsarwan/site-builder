{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "launch-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Requires the thebesads.com zone in this Cloudflare account. Wrangler creates the DNS record + certificate.
  "routes": [{ "pattern": "sitebuilder.thebesads.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "launch-db", "migrations_dir": "migrations" }
  ],
  "workflows": [
    { "name": "launch-site", "binding": "LAUNCH", "class_name": "LaunchSiteWorkflow" },
    { "name": "add-articles", "binding": "CONTENT", "class_name": "AddArticlesWorkflow" },
    { "name": "launch-games-site", "binding": "GAMES_LAUNCH", "class_name": "GamesLaunchWorkflow" }
  ],
  "vars": {
    "GITHUB_OWNER": "adeshsarwan",
    "GITHUB_REPO": "site-builder",
    "GITHUB_BRANCH": "main",
    "CF_ACCOUNT_ID": "", // injected at deploy time from the CLOUDFLARE_ACCOUNT_ID repo secret
    "ALLOWED_ORIGINS": "",
    "GA4_ACCOUNT_ID": "299477311", // Thebesads — every launch creates its GA4 property here
    "OWNER_EMAILS": "adesh@thebesads.com",
    "CLAUDE_MODEL": "claude-sonnet-5-5",
    "PO_RUNTIME_URL": "https://serve.thebesads.com/runtime/config",
    "IMAGE_PROVIDER": "pixabay",
    "JOBS_API_BASE": "https://jobs-api-28975270991.us-central1.run.app", // JOBS_API_KEY is a secret
    "DRY_RUN": "false",
    // H5 games portals: builder repo, Cloudflare account of its Pages projects, shared game files (R2)
    "GAMES_GITHUB_REPO": "h5-games-site-builder",
    "GAMES_GITHUB_BRANCH": "main",
    "GAMES_CF_ACCOUNT_ID": "4df8c97b1058bcf322f39d3dc24001f3",
    "GAMES_CDN": "https://games.gamewhame.com",
    "GAMES_CONTENT_FROM": "torunex-site" // new portals copy this site's lists, reviews, mobile game pages and blog
  }
  // Secrets (wrangler secret put …):
  //   API_KEY            – bearer key your frontend sends
  //   CF_API_TOKEN       – Zone:Edit, DNS:Edit, Workers Scripts:Edit, Workers Routes:Edit, Zone Rulesets:Edit
  //   GITHUB_TOKEN       – fine-grained PAT on adeshsarwan/site-builder: Contents RW, Actions RW
  //   GCP_SA_JSON        – service-account JSON (Site Verification, Search Console, Analytics Admin)
  //   ANTHROPIC_API_KEY  – for generated articles
  //   WEBHOOK_SECRET     – HMAC key for status webhooks
}
