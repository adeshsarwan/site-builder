---
// Job-search landing page: search box, popular-search pills, top employers from the shared jobs database.
// Not funnel-gated; searches lead to /jobs (which runs the funnel the first time).
export const prerender = false;
import Base from '@/layouts/Base.astro';
import AdSlot from '@/components/AdSlot.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { site, abs } from '@/lib/site';
import { topCompanies, companySlug, type Company } from '@/lib/jobs';
import { allArticles } from '@/lib/articles';

const landing = site.jobs.landing;
if (!site.jobs.enabled || !landing) return Astro.redirect('/jobs', 302);

const countries = site.jobs.countries ?? [];
const country = (Astro.url.searchParams.get('country') ?? landing.defaultCountry ?? 'us').toLowerCase();
let companies: Company[] = [];
try { companies = await topCompanies(country, 12); } catch { companies = []; }
const guides = (await allArticles()).filter((a) => ['job-search-strategy', 'interview-prep', 'resume-cover-letters'].includes(a.data.categorySlug)).slice(0, 3);
const countryLabel = countries.find((c) => c.value === country)?.label ?? 'your area';
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const hue = (n: string) => [...n].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) % 360, 7);

Astro.response.headers.set('Cache-Control', 'public, max-age=300');
const seo = {
  title: `Find jobs hiring now | ${site.name}`,
  description: `Search current job openings in ${countries.map((c) => c.label).join(', ') || 'your area'} — remote and on-site, from employers hiring now.`,
  path: '/find-jobs',
  jsonLd: [{
    '@context': 'https://schema.org', '@type': 'WebPage', name: `Find jobs hiring now`, url: abs('/find-jobs'),
    potentialAction: { '@type': 'SearchAction', target: `${abs('/jobs')}?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
  }],
};
---
<Base seo={seo}>
  <section class="fj-hero">
    <div class="wrap fj-hero-inner">
      <h1>{landing.headline}</h1>
      <p>{landing.subhead}</p>
      <form class="fj-search" action="/jobs" method="get" role="search">
        <input name="q" type="search" placeholder="Job title, skill or company" aria-label="Job title, skill or company" />
        {countries.length > 0 && (
          <select name="country" aria-label="Country">
            {countries.map((c) => <option value={c.value} selected={c.value === country}>{c.label}</option>)}
          </select>
        )}
        <button class="btn btn--accent" type="submit">Search jobs</button>
      </form>
      <p class="fj-note">Free · No sign-up · You apply on the employer's own site</p>
    </div>
  </section>

  <section class="wrap fj-pills" aria-label="Popular searches">
    <span class="fj-pills-label">Popular searches</span>
    {landing.popular.map((p) => <a class="pill-link" href={p.href}>{p.label}</a>)}
  </section>

  <div class="wrap"><AdSlot id="ad-incontent" /></div>

  <section class="wrap">
    <div class="section-head">
      <h2 class="section-title">Top employers hiring in {countryLabel}</h2>
      {countries.length > 1 && (
        <nav class="fj-country-tabs" aria-label="Country">
          {countries.map((c) => <a href={`/find-jobs?country=${c.value}`} aria-current={c.value === country ? 'true' : undefined}>{c.label}</a>)}
        </nav>
      )}
    </div>
    {companies.length === 0 && <p class="notice">Employer listings are updating — try a search above.</p>}
    <div class="grid grid--3 fj-companies">
      {companies.map((co) => (
        <a class="fj-company" href={`/companies/${co.slug ?? companySlug(co.company)}`}>
          {co.hasLogo
            ? <img class="fj-logo" src={`/logos/${co.slug}`} alt={`${co.company} logo`} width="56" height="56" loading="lazy" />
            : <span class="fj-mono" style={`--h:${hue(co.company)}`} aria-hidden="true">{initials(co.company)}</span>}
          <span class="fj-co-body">
            <strong>{co.company}</strong>
            <span class="meta">{co.jobs} open {co.jobs === 1 ? 'role' : 'roles'}{co.remoteJobs ? ` · ${co.remoteJobs} remote` : ''}{co.topLocation ? ` · ${co.topLocation}` : ''}</span>
            {co.summary
              ? <span class="fj-titles fj-summary">{co.summary}</span>
              : co.titles.length > 0 && <span class="fj-titles">{co.titles.slice(0, 2).join(' · ')}</span>}
            <span class="fj-co-foot">
              {co.salary && <span class="pill">{co.salary}</span>}
              <span class="fj-view">View openings →</span>
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>

  {site.jobs.categories && (
    <section class="wrap">
      <h2 class="section-title">Browse by category</h2>
      <div class="fj-cats">
        {site.jobs.categories.map((c) => <a class="fj-cat" href={`/jobs?category=${c.value}&country=${country}${c.value === 'remote' ? '&remote=yes' : ''}`}>{c.label}</a>)}
      </div>
    </section>
  )}

  {guides.length > 0 && (
    <section class="wrap">
      <div class="section-head">
        <h2 class="section-title">Before you apply</h2>
        <a href="/article">All guides →</a>
      </div>
      <div class="grid grid--3">{guides.map((a) => <ArticleCard a={a} size="sm" />)}</div>
    </section>
  )}
</Base>
